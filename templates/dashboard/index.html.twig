              fill=""
            />
          </svg>
        </div>

        <div class="mt-5 flex items-end justify-between">
          <div>
            <span class="text-sm text-gray-500 dark:text-gray-400"
              >Total Mahasiswa</span
            >
            <h4
              class="mt-2 text-title-sm font-bold text-gray-800 dark:text-white/90"
            >
              {{ students_total }}
            </h4>
          </div>

          <span
            class="flex items-center gap-1 rounded-full bg-success-50 py-0.5 pl-2 pr-2.5 text-sm font-medium text-success-600 dark:bg-success-500/15 dark:text-success-500"
          >
            {{ students_by_status.active|default(0) }} aktif
          </span>
        </div>
      </div>
      <!-- Metric Item End -->

      <!-- Metric Item: Pegawai -->
      <div
        class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03] md:p-6"
      >
        <div
          class="flex h-12 w-12 items-center justify-center rounded-xl bg-gray-100 dark:bg-gray-800"
        >
          <svg
            class="fill-gray-800 dark:fill-white/90"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
