{% extends 'base.html.twig' %}

{% block content %}
{% include '_partials/breadcrumb.html.twig' with { page_title: 'Dashboard' } %}

<div class="grid grid-cols-12 gap-4 md:gap-6">
  <div class="col-span-12 space-y-6 xl:col-span-7">
    <!-- Metric Group Start -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:gap-6">
      <!-- Metric Item: Mahasiswa -->
      <div
        class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03] md:p-6"
      >
        <div
          class="flex h-12 w-12 items-center justify-center rounded-xl bg-gray-100 dark:bg-gray-800"
        >
          <svg
            class="fill-gray-800 dark:fill-white/90"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
