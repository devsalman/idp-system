{% extends 'base.html.twig' %}

{% block content %}
{% set label_class = 'mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400' %}
{% set input_class = 'dark:bg-dark-900 shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30' %}
{% set select_class = input_class ~ ' appearance-none bg-none pr-11' %}
{% set disabled_class = 'dark:bg-dark-900 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 disabled:cursor-default disabled:bg-gray-100 disabled:text-gray-500 dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:disabled:bg-gray-800 dark:disabled:text-gray-500' %}

{% include '_partials/breadcrumb.html.twig' with { page_title: 'Detail Mahasiswa' } %}

{% for message in app.flashes('success') %}
<div class="mb-6 flex items-center gap-3 rounded-lg border border-success-200 bg-success-50 px-4 py-3 text-theme-sm text-success-700 dark:border-success-500/20 dark:bg-success-500/10 dark:text-success-400">
  {{ message }}
</div>
{% endfor %}

{% for message in app.flashes('error') %}
<div class="mb-6 flex items-center gap-3 rounded-lg border border-error-200 bg-error-50 px-4 py-3 text-theme-sm text-error-700 dark:border-error-500/20 dark:bg-error-500/10 dark:text-error-400">
  {{ message }}
</div>
{% endfor %}

<div
  class="rounded-xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]"
>
  <div class="flex flex-col gap-3 border-b border-gray-100 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-6 dark:border-gray-800">
    <div>
      {% if student.id != null %}
      <h2 class="text-lg font-semibold text-gray-800 dark:text-white/90">
        {{ student.fullname }}
      </h2>
      <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">
        {{ student.nim }} &middot; {{ student.unit ? student.unit.name : '—' }}
      </p>
      {% endif %}
    </div>
    <a
      href="{{ path('app_student_index') }}"
      class="inline-flex items-center justify-center gap-2 rounded-lg bg-gray-100 px-4 py-2.5 text-theme-sm font-medium text-gray-700 transition hover:bg-gray-200 dark:bg-white/5 dark:text-white/90 dark:hover:bg-white/10"
    >
      &larr; Kembali ke daftar
    </a>
  </div>

  {{ form_start(form) }}
  <div class="px-5 py-6 sm:px-6">
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        {{ form_label(form.fullname, null, { label_attr: { class: label_class } }) }}
        {{ form_widget(form.fullname, { attr: { class: input_class } }) }}
        {{ form_errors(form.fullname) }}
      </div>

      <div>
        {{ form_label(form.email, null, { label_attr: { class: label_class } }) }}
        {{ form_widget(form.email, { attr: { class: input_class } }) }}
        {{ form_errors(form.email) }}
      </div>

      <div>
        {{ form_label(form.nim, null, { label_attr: { class: label_class } }) }}
        {{ form_widget(form.nim, { attr: { class: input_class } }) }}
        {{ form_errors(form.nim) }}
      </div>

      <div>
        {{ form_label(form.entryYear, null, { label_attr: { class: label_class } }) }}
        {{ form_widget(form.entryYear, { attr: { class: input_class } }) }}
        {{ form_errors(form.entryYear) }}
      </div>

      <div>
        {{ form_label(form.unit, null, { label_attr: { class: label_class } }) }}
        {{ form_widget(form.unit, { attr: { class: select_class } }) }}
        {{ form_errors(form.unit) }}
      </div>

      <div>
        {{ form_label(form.status, null, { label_attr: { class: label_class } }) }}
        {{ form_widget(form.status, { attr: { class: select_class } }) }}
        {{ form_errors(form.status) }}
      </div>
    </div>

    <div
      class="mt-6 rounded-lg border border-gray-200 p-5 dark:border-gray-800"
    >
      <h3 class="text-sm font-semibold text-gray-800 dark:text-white/90">
        Kredensial SSI
      </h3>
      <p class="mt-0.5 text-theme-xs text-gray-500 dark:text-gray-400">
        Bidang ini dikelola otomatis oleh sistem.
      </p>
      <div class="mt-4 grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <label class="{{ label_class }}">
            DID
          </label>
          <input
            type="text"
            disabled
            value="{{ student.did ?? '—' }}"
            class="{{ disabled_class }}"
          />
        </div>

        <div>
          <label class="{{ label_class }}">
            Token Status
          </label>
          <input
            type="text"
            disabled
            value="{{ student.tokenStatus ?? 'belum' }}"
            class="{{ disabled_class }}"
          />
        </div>

        <div>
          <label class="{{ label_class }}">
            Token Hash
          </label>
          <input
            type="text"
            disabled
            value="{{ student.tokenHash ?? '—' }}"
            class="{{ disabled_class }}"
          />
        </div>

        <div>
          <label class="{{ label_class }}">
            Token Kedaluwarsa
          </label>
          <input
            type="text"
            disabled
            value="{{ student.tokenExpiresAt ? student.tokenExpiresAt|date('d-m-Y H:i') : '—' }}"
            class="{{ disabled_class }}"
          />
        </div>
      </div>

      </div>
        <div class="mt-6 flex items-center gap-3">
        <button
          type="submit"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-brand-500 px-6 py-3 text-sm font-medium text-white shadow-theme-xs transition hover:bg-brand-600"
        >
          Simpan Perubahan
        </button>
        <a
          href="{{ path('app_student_index') }}"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-gray-100 px-6 py-3 text-sm font-medium text-gray-700 transition hover:bg-gray-200 dark:bg-white/5 dark:text-white/90 dark:hover:bg-white/10"
        >
          Batal
        </a>
      </div>
    </div>
  </div>
  {{ form_end(form) }}

  {% if student.tokenStatus is null or student.tokenStatus == 'sent' %}
  <div class="px-5 pb-6">
    <form method="POST" action="{{ path('app_student_send_credential', { id: student.id }) }}">
      <button
        type="submit"
        class="inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-500 px-5 py-2.5 text-sm font-medium text-white shadow-theme-xs transition hover:bg-emerald-600"
      >
        Kirim Kredensial
      </button>
    </form>
  </div>
  {% endif %}
</div>
{% endblock %}
