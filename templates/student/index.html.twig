{% extends 'base.html.twig' %}

{% block content %}
{% include '_partials/breadcrumb.html.twig' with { page_title: 'Mahasiswa' } %}

<div
  class="overflow-hidden rounded-xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]"
>
    <div class="px-5 py-4 sm:px-6 sm:py-5">
        <div
        class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
        >
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
                <a href="{{ path('app_student_new') }}" 
                  class="flex items-center justify-center p-3 font-medium text-white rounded-lg bg-brand-500 text-theme-sm hover:bg-brand-600">
                  +
                </a>
                <button class="flex w-full items-center justify-center gap-2 rounded-lg bg-brand-500 px-4 py-3 text-sm font-medium text-white shadow-theme-xs hover:bg-brand-600 sm:w-auto">Unggah</button>
            </div>
        </div>
    </div>
    <div class="border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
    <div class="max-w-full overflow-x-auto">
    <table class="min-w-full">
      <!-- table header start -->
      <thead>
        <tr class="border-b border-gray-100 dark:border-gray-800">
          <th class="px-5 py-3 sm:px-6">
            <div class="flex items-center">
              <p
                class="font-medium text-gray-500 text-theme-xs dark:text-gray-400"
              >
                Mahasiswa
              </p>
            </div>
          </th>
          <th class="px-5 py-3 sm:px-6">
            <div class="flex items-center">
              <p
                class="font-medium text-gray-500 text-theme-xs dark:text-gray-400"
              >
                NIM
              </p>
            </div>
          </th>
          <th class="px-5 py-3 sm:px-6">
            <div class="flex items-center">
              <p
                class="font-medium text-gray-500 text-theme-xs dark:text-gray-400"
              >
                Unit
              </p>
            </div>
          </th>
          <th class="px-5 py-3 sm:px-6">
            <div class="flex items-center">
              <p
                class="font-medium text-gray-500 text-theme-xs dark:text-gray-400"
              >
                Angkatan
              </p>
            </div>
          </th>
          <th class="px-5 py-3 sm:px-6">
            <div class="flex items-center">
              <p
                class="font-medium text-gray-500 text-theme-xs dark:text-gray-400"
              >
                Status
              </p>
            </div>
          </th>
          <th class="px-5 py-3 sm:px-6">
            <div class="flex items-center">
              <p
                class="font-medium text-gray-500 text-theme-xs dark:text-gray-400"
              >
                Token VC
              </p>
            </div>
          </th>
        </tr>
      </thead>
      <!-- table header end -->
      <!-- table body start -->
      <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
        {% for student in students %}
        <tr
          class="cursor-pointer transition-colors hover:bg-gray-50 dark:hover:bg-white/[0.03]"
          @click="window.location = '{{ path('app_student_show', { id: student.id }) }}'"
        >
          <td class="px-5 py-4 sm:px-6">
            <div class="flex items-center">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 overflow-hidden rounded-full bg-gray-100 dark:bg-gray-800">
                  <span
                    class="flex h-full w-full items-center justify-center text-theme-sm font-semibold text-gray-600 dark:text-gray-300"
                  >
                    {{ student.fullname|slice(0, 1)|upper }}
                  </span>
                </div>

                <div>
                  <a
                    href="{{ path('app_student_show', { id: student.id }) }}"
                    class="block font-medium text-gray-800 text-theme-sm hover:text-brand-500 dark:text-white/90 dark:hover:text-brand-400"
                  >
                    {{ student.fullname }}
                  </a>
                  <span
                    class="block text-gray-500 text-theme-xs dark:text-gray-400"
                  >
                    {{ student.email }}
                  </span>
                </div>
              </div>
            </div>
          </td>
          <td class="px-5 py-4 sm:px-6">
            <div class="flex items-center">
              <p class="text-gray-500 text-theme-sm dark:text-gray-400">
                {{ student.nim }}
              </p>
            </div>
          </td>
          <td class="px-5 py-4 sm:px-6">
            <div class="flex items-center">
              <p class="text-gray-500 text-theme-sm dark:text-gray-400">
                {{ student.unit.name }}
              </p>
            </div>
          </td>
          <td class="px-5 py-4 sm:px-6">
            <div class="flex items-center">
              <p class="text-gray-500 text-theme-sm dark:text-gray-400">
                {{ student.entryYear }}
              </p>
            </div>
          </td>
          <td class="px-5 py-4 sm:px-6">
            <div class="flex items-center">
              {% set status_class = {
                'active': 'bg-success-50 text-success-700 dark:bg-success-500/15 dark:text-success-500',
                'graduated': 'bg-warning-50 text-warning-700 dark:bg-warning-500/15 dark:text-warning-400',
                'suspended': 'bg-error-50 text-error-700 dark:bg-error-500/15 dark:text-error-500'
              } %}
              <p
                class="rounded-full px-2 py-0.5 text-theme-xs font-medium {{ status_class[student.status] ?? 'bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300' }}"
              >
                {{ student.status }}
              </p>
            </div>
          </td>
          <td class="px-5 py-4 sm:px-6">
            <div class="flex items-center">
              {% if student.tokenStatus == 'claimed' %}
              <p
                class="rounded-full bg-success-50 px-2 py-0.5 text-theme-xs font-medium text-success-700 dark:bg-success-500/15 dark:text-success-500"
              >
                Terklaim
              </p>
              {% elseif student.tokenStatus == 'sent' %}
              <p
                class="rounded-full bg-warning-50 px-2 py-0.5 text-theme-xs font-medium text-warning-700 dark:bg-warning-500/15 dark:text-warning-400"
              >
                Dikirim
              </p>
              {% else %}
              <p
                class="rounded-full bg-gray-100 px-2 py-0.5 text-theme-xs font-medium text-gray-700 dark:bg-gray-800 dark:text-gray-300"
              >
                Belum
              </p>
              {% endif %}
            </div>
          </td>
        </tr>
        {% else %}
        <tr>
          <td colspan="6" class="px-5 py-8 text-center">
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">
              Belum ada data mahasiswa.
            </p>
          </td>
        </tr>
        {% endfor %}
      </tbody>
      <!-- table body end -->
    </table>
  </div>
</div>
{% endblock %}
