<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Klaim Kredensial SSI — IdP Kampus</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f4f5f7; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }
    .card { background: #fff; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); max-width: 480px; width: 100%; overflow: hidden; }
    .header { background: #4f46e5; padding: 32px; text-align: center; }
    .header h1 { color: #fff; font-size: 20px; margin: 0 0 6px; }
    .header p { color: #c7d2fe; font-size: 13px; margin: 0; }
    .body { padding: 40px; }
    .status-icon { text-align: center; margin-bottom: 20px; font-size: 48px; }
    .title { text-align: center; font-size: 18px; font-weight: 600; color: #1f2937; margin-bottom: 12px; }
    .message { text-align: center; color: #4b5563; font-size: 14px; line-height: 1.6; margin-bottom: 24px; }
    .btn { display: block; width: 100%; padding: 14px; text-align: center; background: #4f46e5; color: #fff; font-size: 15px; font-weight: 600; border: none; border-radius: 8px; cursor: pointer; text-decoration: none; transition: background 0.2s; }
    .btn:hover { background: #4338ca; }
    .btn-done { background: #059669; }
    .btn-done:hover { background: #047857; }
    .alert { background: #fef3c7; border-radius: 8px; padding: 12px 16px; margin-bottom: 20px; }
    .alert p { color: #92400e; font-size: 13px; line-height: 1.5; }
    .footer { background: #f9fafb; padding: 20px 40px; border-top: 1px solid #e5e7eb; text-align: center; }
    .footer p { color: #9ca3af; font-size: 12px; }
  </style>
</head>
<body>
  <div class="card">
    <div class="header">
      <h1>IdP Kampus</h1>
      <p>Identity Provider — Self-Sovereign Identity</p>
    </div>

    <div class="body">
      {% if status == 'pending' %}
        <div class="status-icon">🔐</div>
        <div class="title">Klaim Kredensial SSI</div>
        <div class="message">
          Halo <strong>{{ name }}</strong>,<br><br>
          Anda akan mengklaim kredensial Verifiable Credential (VC) sebagai <strong>{{ entity_type }}</strong>.
          Pastikan data Anda benar sebelum melanjutkan.
        </div>
        <form method="POST" action="{{ path('app_claim_confirm', { token: token }) }}">
          <button type="submit" class="btn">Konfirmasi Klaim Kredensial</button>
        </form>

      {% elseif status == 'success' %}
        <div class="status-icon">✅</div>
        <div class="title">Kredensial Berhasil Diklaim</div>
        <div class="message">
          Selamat, <strong>{{ name }}</strong>!<br><br>
          Kredensial Verifiable Credential Anda telah berhasil diklaim.
          Kredensial akan segera diterbitkan oleh sistem.
        </div>
        <a href="#" class="btn btn-done">Selesai</a>

      {% elseif status == 'already_claimed' %}
        <div class="status-icon">ℹ️</div>
        <div class="title">Sudah Diklaim</div>
        <div class="message">
          Halo <strong>{{ name }}</strong>,<br><br>
          Kredensial Anda sudah pernah diklaim sebelumnya.
          Tidak perlu melakukan klaim ulang.
        </div>
        <a href="#" class="btn btn-done">Selesai</a>

      {% elseif status == 'expired' %}
        <div class="status-icon">⏰</div>
        <div class="title">Tautan Kedaluwarsa</div>
        <div class="message">
          Halo <strong>{{ name }}</strong>,<br><br>
          Tautan klaim kredensial Anda sudah kedaluwarsa.
          Silakan hubungi administrator untuk mendapatkan tautan baru.
        </div>
        <div class="alert">
          <p>Hubungi admin@identitylab.id untuk meminta tautan klaim baru.</p>
        </div>
      {% endif %}
    </div>

    <div class="footer">
      <p>IdP Kampus — © {{ "now"|date("Y") }} IdentityLab</p>
    </div>
  </div>
</body>
</html>
